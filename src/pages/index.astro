---
import Layout from '../layouts/Layout.astro';
---
<Layout title="INGLŌ KŌRE — Aprende inglés de verdad">

<style>
  /* HERO */
  .hero { min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 120px 24px 80px; position: relative; overflow: hidden; }
  canvas#hero-canvas { position: absolute; inset: 0; pointer-events: none; opacity: 0.18; }
  .orb { position: absolute; border-radius: 50%; filter: blur(100px); pointer-events: none; }
  .orb-a { width: 600px; height: 600px; background: rgba(42,107,181,0.25); top: -150px; left: -150px; }
  .orb-b { width: 500px; height: 500px; background: rgba(245,166,35,0.12); bottom: -80px; right: -120px; }
  .hero-content { position: relative; z-index: 2; max-width: 820px; }
  .hero-eyebrow { display: inline-flex; align-items: center; gap: 8px; background: rgba(245,166,35,0.1); border: 1px solid rgba(245,166,35,0.28); border-radius: 100px; padding: 7px 18px; font-size: 0.75rem; font-weight: 700; color: var(--gold); letter-spacing: 2px; text-transform: uppercase; margin-bottom: 36px; animation: fadeUp 0.7s ease both; }
  .hero-logo-wrap { display: flex; align-items: center; justify-content: center; gap: 20px; margin-bottom: 20px; animation: fadeUp 0.7s 0.1s ease both; flex-wrap: wrap; }
  .hero-icon { width: 90px; height: 90px; border-radius: 22px; box-shadow: 0 0 60px rgba(245,166,35,0.5), 0 0 120px rgba(245,166,35,0.2); animation: iconFloat 4s ease-in-out infinite; }
  .hero-title { font-family: 'Cinzel', serif; font-size: clamp(3.5rem,9vw,7rem); font-weight: 900; line-height: 1; letter-spacing: 4px; }
  .hero-title .gold { color: var(--gold); }
  .hero-sub { font-size: clamp(1rem,2vw,1.25rem); color: var(--light); letter-spacing: 3px; text-transform: uppercase; font-weight: 300; margin: 14px 0 28px; animation: fadeUp 0.7s 0.2s ease both; }
  .hero-desc { font-size: 1.08rem; color: var(--muted); line-height: 1.75; max-width: 560px; margin: 0 auto 48px; animation: fadeUp 0.7s 0.3s ease both; }
  .hero-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; animation: fadeUp 0.7s 0.4s ease both; }
  .hero-flags { display: flex; gap: 20px; justify-content: center; margin-top: 52px; animation: fadeUp 0.7s 0.5s ease both; flex-wrap: wrap; }
  .flag-tag { display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.05); border: 1px solid var(--border); border-radius: 100px; padding: 10px 20px; font-size: 0.85rem; font-weight: 500; color: var(--muted); }

  /* FEATURES */
  .feat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px,1fr)); gap: 18px; margin-top: 56px; }
  .feat-card { background: rgba(255,255,255,0.025); border: 1px solid var(--border); border-radius: 20px; padding: 30px; transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s; cursor: default; }
  .feat-card:hover { transform: translateY(-6px); border-color: rgba(245,166,35,0.25); box-shadow: 0 20px 60px rgba(0,0,0,0.35); }
  .feat-ic { font-size: 2.2rem; margin-bottom: 16px; display: block; }
  .feat-t { font-size: 1.05rem; font-weight: 700; margin-bottom: 8px; }
  .feat-d { font-size: 0.88rem; color: var(--muted); line-height: 1.65; }
  .feat-badge { display: inline-block; background: rgba(245,166,35,0.1); border: 1px solid rgba(245,166,35,0.3); border-radius: 100px; padding: 3px 10px; font-size: 0.65rem; font-weight: 700; color: var(--gold); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 10px; }

  /* CONVERSATION SECTION */
  .conv-bg { background: linear-gradient(135deg, rgba(26,58,107,0.2), rgba(10,22,40,0.05)); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .conv-layout { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; margin-top: 0; }
  .conv-scenarios { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 32px; }
  .conv-scenario { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 14px; padding: 16px; transition: transform 0.3s, border-color 0.3s; cursor: default; }
  .conv-scenario:hover { transform: translateY(-3px); border-color: rgba(245,166,35,0.25); }
  .conv-scenario-ic { font-size: 1.6rem; margin-bottom: 6px; display: block; }
  .conv-scenario-t { font-size: 0.82rem; font-weight: 600; color: var(--white); margin-bottom: 2px; }
  .conv-scenario-lv { font-size: 0.7rem; color: var(--muted); }
  .conv-flow { display: flex; flex-direction: column; gap: 14px; }
  .conv-bubble { border-radius: 16px; padding: 14px 18px; max-width: 85%; }
  .conv-bubble.ai { background: rgba(42,107,181,0.15); border: 1px solid rgba(74,159,232,0.25); align-self: flex-start; border-bottom-left-radius: 4px; }
  .conv-bubble.user { background: rgba(245,166,35,0.1); border: 1px solid rgba(245,166,35,0.25); align-self: flex-end; border-bottom-right-radius: 4px; margin-left: auto; }
  .conv-bubble.correction { background: rgba(29,184,122,0.08); border: 1px solid rgba(29,184,122,0.25); align-self: flex-start; border-bottom-left-radius: 4px; }
  .conv-bubble-who { font-size: 0.65rem; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; margin-bottom: 5px; color: var(--muted); }
  .conv-bubble-text { font-size: 0.9rem; color: var(--white); line-height: 1.5; }
  .conv-bubble-fix { font-size: 0.8rem; color: var(--green); font-style: italic; margin-top: 4px; }
  .conv-mic { display: flex; align-items: center; justify-content: center; gap: 12px; margin-top: 8px; }
  .conv-mic-btn { width: 52px; height: 52px; border-radius: 50%; background: var(--gold); display: flex; align-items: center; justify-content: center; font-size: 1.4rem; box-shadow: 0 0 24px rgba(245,166,35,0.4); animation: goldPulse 2s ease infinite; }
  .conv-mic-lbl { font-size: 0.8rem; color: var(--muted); }
  .conv-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }
  .conv-tag { display: flex; align-items: center; gap: 6px; background: rgba(255,255,255,0.04); border: 1px solid var(--border); border-radius: 100px; padding: 6px 14px; font-size: 0.8rem; color: var(--muted); }

  /* LEVELS */
  .lv-bg { background: rgba(255,255,255,0.015); }
  .lv-grid { display: grid; grid-template-columns: repeat(5,1fr); gap: 14px; margin-top: 56px; }
  .lv-card { background: rgba(255,255,255,0.04); border: 1.5px solid var(--border); border-radius: 16px; padding: 22px 14px; text-align: center; transition: transform 0.3s, box-shadow 0.3s; cursor: default; }
  .lv-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(0,0,0,0.3); }
  .lv-mcer { font-family: 'Cinzel', serif; font-size: 2rem; font-weight: 900; display: block; margin-bottom: 6px; }
  .lv-name { font-size: 0.75rem; color: var(--muted); font-weight: 500; display: block; margin-bottom: 6px; }
  .lv-conv { font-size: 0.65rem; color: var(--muted); display: block; margin-top: 4px; }
  .lv-free { display: inline-block; background: rgba(29,184,122,0.12); border: 1px solid var(--green); color: var(--green); font-size: 0.6rem; font-weight: 700; padding: 3px 10px; border-radius: 100px; letter-spacing: 1px; text-transform: uppercase; }
  .lv-prem { display: inline-block; background: rgba(245,166,35,0.1); border: 1px solid rgba(245,166,35,0.4); color: var(--gold); font-size: 0.6rem; font-weight: 700; padding: 3px 10px; border-radius: 100px; }

  /* MISSIONS */
  .ms-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(200px,1fr)); gap: 14px; margin-top: 56px; }
  .ms-card { background: rgba(255,255,255,0.03); border: 1px solid var(--border); border-radius: 16px; padding: 22px; transition: transform 0.3s, border-color 0.3s; cursor: default; }
  .ms-card:hover { transform: translateY(-4px); border-color: rgba(245,166,35,0.22); }
  .ms-day { font-size: 0.68rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .ms-ic { font-size: 1.8rem; margin-bottom: 10px; display: block; }
  .ms-t { font-size: 0.88rem; font-weight: 600; margin-bottom: 6px; }
  .ms-xp { font-size: 0.78rem; color: var(--gold); font-weight: 700; }

  /* STATS */
  .stats-bg { background: linear-gradient(135deg, rgba(26,58,107,0.25), rgba(10,22,40,0.1)); border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }
  .stats-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 32px; text-align: center; }
  .st-num { font-family: 'Cinzel', serif; font-size: 3rem; font-weight: 900; color: var(--gold); display: block; margin-bottom: 6px; }
  .st-lbl { font-size: 0.88rem; color: var(--muted); font-weight: 500; }

  /* PRICING */
  .pr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 56px; max-width: 700px; }
  .pr-card { background: rgba(255,255,255,0.03); border: 1.5px solid var(--border); border-radius: 24px; padding: 34px; position: relative; transition: transform 0.3s; }
  .pr-card:hover { transform: translateY(-5px); }
  .pr-card.featured { border-color: var(--gold); background: rgba(245,166,35,0.05); }
  .pr-badge { position: absolute; top: -13px; left: 50%; transform: translateX(-50%); background: var(--gold); color: var(--navy); font-size: 0.68rem; font-weight: 800; padding: 5px 16px; border-radius: 100px; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap; }
  .pr-plan { font-size: 0.8rem; color: var(--muted); font-weight: 600; margin-bottom: 10px; }
  .pr-price { font-size: 2.4rem; font-weight: 800; }
  .pr-price span { font-size: 1rem; color: var(--muted); font-weight: 400; }
  .pr-save { font-size: 0.82rem; color: var(--green); margin-top: 6px; margin-bottom: 24px; }
  .pr-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .pr-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 0.88rem; color: var(--muted); }
  .pr-list li::before { content: '✓'; color: var(--green); font-weight: 700; flex-shrink: 0; margin-top: 1px; }
  .cert-note { margin-top: 20px; padding: 14px 18px; background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.07); border-radius: 12px; display: flex; align-items: flex-start; gap: 10px; max-width: 700px; }
  .cert-note-txt { font-size: 0.8rem; color: rgba(255,255,255,0.32); line-height: 1.6; font-style: italic; }

  /* CTA */
  .cta-sec { text-align: center; overflow: hidden; }
  .cta-glow { position: absolute; width: 700px; height: 700px; background: radial-gradient(circle, rgba(245,166,35,0.1), transparent 65%); top: 50%; left: 50%; transform: translate(-50%,-50%); pointer-events: none; }

  @media(max-width:900px) {
    .conv-layout { grid-template-columns: 1fr; gap: 40px; }
    .lv-grid { grid-template-columns: repeat(2,1fr); }
    .stats-row { grid-template-columns: repeat(2,1fr); gap: 24px; }
    .pr-grid { grid-template-columns: 1fr; max-width: 100%; }
  }
  @media(max-width:600px) {
    .ms-grid { grid-template-columns: 1fr 1fr; }
    .conv-scenarios { grid-template-columns: 1fr 1fr; }
  }
</style>

<!-- HERO -->
<section class="hero">
  <canvas id="hero-canvas"></canvas>
  <div class="orb orb-a"></div>
  <div class="orb orb-b"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">🦁 App de inglés · A1 hasta C2 · IA Conversacional</div>
    <div class="hero-logo-wrap">
      <img src="/icon.png" alt="INGLŌ KŌRE" class="hero-icon"/>
      <h1 class="hero-title">INGLŌ <span class="gold">KŌRE</span></h1>
    </div>
    <p class="hero-sub">Aprende inglés de verdad</p>
    <p class="hero-desc">Domina el inglés americano y británico con lecciones interactivas, conversaciones reales con IA, misiones diarias y certificados de nivel. De A1 a C2, paso a paso.</p>
    <div class="hero-btns">
      <a href="https://play.google.com/store" target="_blank" class="btn-gold">🤖 Google Play — Gratis</a>
      <a href="#conversacion" class="btn-ghost">Ver Conversación IA →</a>
    </div>
    <div class="hero-flags">
      <div class="flag-tag">🇺🇸 Inglés Americano</div>
      <div class="flag-tag">🇬🇧 Inglés Británico</div>
      <div class="flag-tag">🤖 IA Conversacional</div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap">
  <div class="marquee-track">
    <div class="m-chip"><span class="m-dot" style="background:#4A9FE8"></span>A1 Básico 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#4A9FE8"></span>A1+ Básico 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#2A6BB5"></span>A2 Básico 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#1DB87A"></span>B1 Intermedio 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#1DB87A"></span>B1+ Intermedio 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#F5A623"></span>B2 Intermedio 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#F5A623"></span>B2+ Intermedio 4</div>
    <div class="m-chip"><span class="m-dot" style="background:#E8453C"></span>C1 Avanzado 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#E8453C"></span>C1+ Avanzado 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#9B59B6"></span>C2 Avanzado 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#4A9FE8"></span>A1 Básico 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#4A9FE8"></span>A1+ Básico 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#2A6BB5"></span>A2 Básico 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#1DB87A"></span>B1 Intermedio 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#1DB87A"></span>B1+ Intermedio 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#F5A623"></span>B2 Intermedio 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#F5A623"></span>B2+ Intermedio 4</div>
    <div class="m-chip"><span class="m-dot" style="background:#E8453C"></span>C1 Avanzado 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#E8453C"></span>C1+ Avanzado 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#9B59B6"></span>C2 Avanzado 3</div>
  </div>
</div>

<!-- FEATURES -->
<section id="funciones">
  <div class="container">
    <div class="reveal">
      <p class="s-label">¿Por qué INGLŌ KŌRE?</p>
      <h2 class="s-title">Todo lo que necesitas para dominar el inglés</h2>
      <p class="s-desc">Diseñada desde cero para hispanohablantes que quieren aprender inglés de verdad — no solo memorizar vocabulario.</p>
    </div>
    <div class="feat-grid">
      <div class="feat-card reveal">
        <div class="feat-badge">⭐ Destacado</div>
        <span class="feat-ic">🎙️</span>
        <h3 class="feat-t">Conversación real con IA</h3>
        <p class="feat-d">Habla en inglés con una IA que te escucha, responde y corrige tus errores en tiempo real. Al final recibes un resumen en español con tus puntos fuertes y áreas a mejorar.</p>
      </div>
      <div class="feat-card reveal">
        <span class="feat-ic">🎯</span>
        <h3 class="feat-t">Fill in the blank interactivo</h3>
        <p class="feat-d">Completa oraciones reales. Aprende gramática en contexto, no de memoria. Feedback inmediato en cada respuesta.</p>
      </div>
      <div class="feat-card reveal">
        <span class="feat-ic">📚</span>
        <h3 class="feat-t">Explicaciones paso a paso</h3>
        <p class="feat-d">Al fallar, 3 pasos claros + conclusión explican exactamente por qué. Aprende de cada error (Premium).</p>
      </div>
      <div class="feat-card reveal">
        <span class="feat-ic">🔥</span>
        <h3 class="feat-t">Racha diaria</h3>
        <p class="feat-d">Mantén tu racha estudiando cada día. El sistema registra tu constancia y premia tu disciplina con XP extra.</p>
      </div>
      <div class="feat-card reveal">
        <span class="feat-ic">📄</span>
        <h3 class="feat-t">Certificados de nivel</h3>
        <p class="feat-d">Al completar cada nivel y su conversación final, obtén un certificado PDF descargable de progreso.</p>
      </div>
      <div class="feat-card reveal">
        <span class="feat-ic">🇺🇸🇬🇧</span>
        <h3 class="feat-t">Dos acentos reales</h3>
        <p class="feat-d">Americano y británico con sus diferencias de vocabulario, gramática y pronunciación. Progreso separado por acento.</p>
      </div>
    </div>
  </div>
</section>

<!-- CONVERSACIÓN CON IA -->
<section id="conversacion" class="conv-bg">
  <div class="container">
    <div class="conv-layout">

      <!-- Izquierda: info -->
      <div>
        <div class="reveal">
          <p class="s-label">🎙️ Novedad — Exclusivo en INGLŌ KŌRE</p>
          <h2 class="s-title">Practica conversaciones reales con IA</h2>
          <p class="s-desc">Al completar cada nivel desbloqueas una conversación final con IA. Hablas en inglés, la IA te escucha, responde y corrige tus errores al instante.</p>
        </div>

        <div class="conv-tags reveal">
          <div class="conv-tag">🎙️ Reconocimiento de voz</div>
          <div class="conv-tag">🔊 IA habla en inglés</div>
          <div class="conv-tag">✅ Corrección inmediata</div>
          <div class="conv-tag">📝 Resumen en español</div>
          <div class="conv-tag">🇺🇸 Acento americano</div>
          <div class="conv-tag">🇬🇧 Acento británico</div>
        </div>

        <div class="conv-scenarios reveal">
          <div class="conv-scenario">
            <span class="conv-scenario-ic">👋</span>
            <div class="conv-scenario-t">Conociendo a alguien</div>
            <div class="conv-scenario-lv">A1 · Básico 1</div>
          </div>
          <div class="conv-scenario">
            <span class="conv-scenario-ic">🛒</span>
            <div class="conv-scenario-t">En el supermercado</div>
            <div class="conv-scenario-lv">A1+ · Básico 2</div>
          </div>
          <div class="conv-scenario">
            <span class="conv-scenario-ic">🍕</span>
            <div class="conv-scenario-t">En un restaurante</div>
            <div class="conv-scenario-lv">A2 · Básico 3</div>
          </div>
          <div class="conv-scenario">
            <span class="conv-scenario-ic">✈️</span>
            <div class="conv-scenario-t">En el aeropuerto</div>
            <div class="conv-scenario-lv">B1 · Intermedio 1</div>
          </div>
          <div class="conv-scenario">
            <span class="conv-scenario-ic">🏨</span>
            <div class="conv-scenario-t">En un hotel</div>
            <div class="conv-scenario-lv">B1+ · Intermedio 2</div>
          </div>
          <div class="conv-scenario">
            <span class="conv-scenario-ic">💼</span>
            <div class="conv-scenario-t">Entrevista de trabajo</div>
            <div class="conv-scenario-lv">B2 · Intermedio 3</div>
          </div>
          <div class="conv-scenario">
            <span class="conv-scenario-ic">📞</span>
            <div class="conv-scenario-t">Llamada formal</div>
            <div class="conv-scenario-lv">B2+ · Intermedio 4</div>
          </div>
          <div class="conv-scenario">
            <span class="conv-scenario-ic">🎓</span>
            <div class="conv-scenario-t">Debate de opinión</div>
            <div class="conv-scenario-lv">C1+ · Avanzado</div>
          </div>
        </div>
      </div>

      <!-- Derecha: demo visual -->
      <div class="reveal">
        <div style="background:rgba(255,255,255,0.025);border:1px solid var(--border);border-radius:20px;padding:24px;display:flex;flex-direction:column;gap:14px;">

          <!-- Header del chat -->
          <div style="display:flex;align-items:center;gap:10px;padding-bottom:14px;border-bottom:1px solid var(--border)">
            <span style="font-size:1.5rem">✈️</span>
            <div>
              <div style="font-size:0.9rem;font-weight:700;color:#fff">En el aeropuerto</div>
              <div style="font-size:0.72rem;color:var(--muted)">B1 · Inglés Americano · Turno 2 de 4</div>
            </div>
            <div style="margin-left:auto;background:rgba(245,166,35,0.1);border:1px solid rgba(245,166,35,0.3);border-radius:8px;padding:4px 10px;font-size:0.75rem;font-weight:700;color:var(--gold)">B1</div>
          </div>

          <!-- Burbujas de chat -->
          <div class="conv-flow">
            <div class="conv-bubble ai">
              <div class="conv-bubble-who">🤖 AI — Agente de vuelo</div>
              <div class="conv-bubble-text">Good morning! Can I see your passport and booking reference, please?</div>
              <div style="margin-top:6px;font-size:0.72rem;color:var(--light);cursor:pointer">🔊 Escuchar</div>
            </div>

            <div class="conv-bubble user">
              <div class="conv-bubble-who">👤 Tú</div>
              <div class="conv-bubble-text">Yes, here is my passport. I have reservation for the flight to Miami.</div>
            </div>

            <div class="conv-bubble correction">
              <div class="conv-bubble-who" style="color:var(--green)">✅ Corrección</div>
              <div class="conv-bubble-text" style="color:rgba(255,255,255,0.6);font-size:0.82rem">Falta el artículo "a" antes de "reservation"</div>
              <div class="conv-bubble-fix">Di: "I have <strong>a</strong> reservation for the flight to Miami."</div>
            </div>

            <div class="conv-bubble ai">
