---
import Layout from '../layouts/Layout.astro';
---
<Layout title="INGLŌ KŌRE — Aprende inglés de verdad">

<style>
  /* HERO */
  .hero {
    min-height: 100vh; display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    text-align: center; padding: 120px 24px 80px;
    position: relative; overflow: hidden;
  }
  canvas#hero-canvas { position: absolute; inset: 0; pointer-events: none; opacity: 0.18; }
  .orb { position: absolute; border-radius: 50%; filter: blur(100px); pointer-events: none; }
  .orb-a { width: 600px; height: 600px; background: rgba(42,107,181,0.25); top: -150px; left: -150px; }
  .orb-b { width: 500px; height: 500px; background: rgba(245,166,35,0.12); bottom: -80px; right: -120px; }
  .orb-c { width: 350px; height: 350px; background: rgba(29,184,122,0.08); top: 50%; left: 50%; transform: translate(-50%,-50%); }

  .hero-content { position: relative; z-index: 2; max-width: 820px; }

  .hero-eyebrow {
    display: inline-flex; align-items: center; gap: 8px;
    background: rgba(245,166,35,0.1); border: 1px solid rgba(245,166,35,0.28);
    border-radius: 100px; padding: 7px 18px;
    font-size: 0.75rem; font-weight: 700; color: var(--gold); letter-spacing: 2px; text-transform: uppercase;
    margin-bottom: 36px; animation: fadeUp 0.7s ease both;
  }
  .hero-logo-wrap {
    display: flex; align-items: center; justify-content: center;
    gap: 20px; margin-bottom: 20px; animation: fadeUp 0.7s 0.1s ease both;
    flex-wrap: wrap;
  }
  .hero-icon {
    width: 90px; height: 90px; border-radius: 22px;
    box-shadow: 0 0 60px rgba(245,166,35,0.5), 0 0 120px rgba(245,166,35,0.2);
    animation: iconFloat 4s ease-in-out infinite;
  }
  .hero-title {
    font-family: 'Cinzel', serif; font-size: clamp(3.5rem,9vw,7rem);
    font-weight: 900; line-height: 1; letter-spacing: 4px;
  }
  .hero-title .gold { color: var(--gold); }
  .hero-sub {
    font-size: clamp(1rem,2vw,1.25rem); color: var(--light);
    letter-spacing: 3px; text-transform: uppercase; font-weight: 300;
    margin: 14px 0 28px; animation: fadeUp 0.7s 0.2s ease both;
  }
  .hero-desc {
    font-size: 1.08rem; color: var(--muted); line-height: 1.75;
    max-width: 560px; margin: 0 auto 48px; animation: fadeUp 0.7s 0.3s ease both;
  }
  .hero-btns { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; animation: fadeUp 0.7s 0.4s ease both; }
  .hero-flags { display: flex; gap: 20px; justify-content: center; margin-top: 52px; animation: fadeUp 0.7s 0.5s ease both; flex-wrap: wrap; }
  .flag-tag {
    display: flex; align-items: center; gap: 8px;
    background: rgba(255,255,255,0.05); border: 1px solid var(--border);
    border-radius: 100px; padding: 10px 20px;
    font-size: 0.85rem; font-weight: 500; color: var(--muted);
  }

  /* FEATURES */
  .feat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px,1fr)); gap: 18px; margin-top: 56px; }
  .feat-card {
    background: rgba(255,255,255,0.025); border: 1px solid var(--border);
    border-radius: 20px; padding: 30px;
    transition: transform 0.3s, border-color 0.3s, box-shadow 0.3s; cursor: default;
  }
  .feat-card:hover { transform: translateY(-6px); border-color: rgba(245,166,35,0.25); box-shadow: 0 20px 60px rgba(0,0,0,0.35); }
  .feat-ic { font-size: 2.2rem; margin-bottom: 16px; display: block; }
  .feat-t { font-size: 1.05rem; font-weight: 700; margin-bottom: 8px; }
  .feat-d { font-size: 0.88rem; color: var(--muted); line-height: 1.65; }

  /* LEVELS */
  .lv-bg { background: rgba(255,255,255,0.015); }
  .lv-grid { display: grid; grid-template-columns: repeat(5,1fr); gap: 14px; margin-top: 56px; }
  .lv-card {
    background: rgba(255,255,255,0.04); border: 1.5px solid var(--border);
    border-radius: 16px; padding: 22px 14px; text-align: center;
    transition: transform 0.3s, box-shadow 0.3s; cursor: default;
  }
  .lv-card:hover { transform: translateY(-5px); box-shadow: 0 16px 40px rgba(0,0,0,0.3); }
  .lv-mcer { font-family: 'Cinzel', serif; font-size: 2rem; font-weight: 900; display: block; margin-bottom: 6px; }
  .lv-name { font-size: 0.75rem; color: var(--muted); font-weight: 500; display: block; }
  .lv-free {
    display: inline-block; background: rgba(29,184,122,0.12);
    border: 1px solid var(--green); color: var(--green);
    font-size: 0.6rem; font-weight: 700; padding: 3px 10px;
    border-radius: 100px; margin-top: 8px; letter-spacing: 1px; text-transform: uppercase;
  }
  .lv-prem {
    display: inline-block; background: rgba(245,166,35,0.1);
    border: 1px solid rgba(245,166,35,0.4); color: var(--gold);
    font-size: 0.6rem; font-weight: 700; padding: 3px 10px;
    border-radius: 100px; margin-top: 8px; letter-spacing: 1px;
  }

  /* MISSIONS */
  .ms-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(200px,1fr)); gap: 14px; margin-top: 56px; }
  .ms-card {
    background: rgba(255,255,255,0.03); border: 1px solid var(--border);
    border-radius: 16px; padding: 22px;
    transition: transform 0.3s, border-color 0.3s; cursor: default;
  }
  .ms-card:hover { transform: translateY(-4px); border-color: rgba(245,166,35,0.22); }
  .ms-day { font-size: 0.68rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--muted); margin-bottom: 10px; }
  .ms-ic { font-size: 1.8rem; margin-bottom: 10px; display: block; }
  .ms-t { font-size: 0.88rem; font-weight: 600; margin-bottom: 6px; }
  .ms-xp { font-size: 0.78rem; color: var(--gold); font-weight: 700; }

  /* STATS */
  .stats-bg {
    background: linear-gradient(135deg, rgba(26,58,107,0.25), rgba(10,22,40,0.1));
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
  }
  .stats-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 32px; text-align: center; }
  .st-num { font-family: 'Cinzel', serif; font-size: 3rem; font-weight: 900; color: var(--gold); display: block; margin-bottom: 6px; }
  .st-lbl { font-size: 0.88rem; color: var(--muted); font-weight: 500; }

  /* PRICING */
  .pr-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 56px; max-width: 700px; }
  .pr-card {
    background: rgba(255,255,255,0.03); border: 1.5px solid var(--border);
    border-radius: 24px; padding: 34px; position: relative; transition: transform 0.3s;
  }
  .pr-card:hover { transform: translateY(-5px); }
  .pr-card.featured { border-color: var(--gold); background: rgba(245,166,35,0.05); }
  .pr-badge {
    position: absolute; top: -13px; left: 50%; transform: translateX(-50%);
    background: var(--gold); color: var(--navy);
    font-size: 0.68rem; font-weight: 800; padding: 5px 16px;
    border-radius: 100px; letter-spacing: 1px; text-transform: uppercase; white-space: nowrap;
  }
  .pr-plan { font-size: 0.8rem; color: var(--muted); font-weight: 600; margin-bottom: 10px; }
  .pr-price { font-size: 2.4rem; font-weight: 800; }
  .pr-price span { font-size: 1rem; color: var(--muted); font-weight: 400; }
  .pr-save { font-size: 0.82rem; color: var(--green); margin-top: 6px; margin-bottom: 24px; }
  .pr-list { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .pr-list li { display: flex; align-items: flex-start; gap: 10px; font-size: 0.88rem; color: var(--muted); }
  .pr-list li::before { content: '✓'; color: var(--green); font-weight: 700; flex-shrink: 0; margin-top: 1px; }

  /* CERT NOTE */
  .cert-note {
    margin-top: 24px; padding: 16px 20px;
    background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.07);
    border-radius: 12px; display: flex; align-items: flex-start; gap: 10px;
    max-width: 700px;
  }
  .cert-note-txt { font-size: 0.82rem; color: rgba(255,255,255,0.35); line-height: 1.6; font-style: italic; }

  /* CTA */
  .cta-sec { text-align: center; overflow: hidden; }
  .cta-glow {
    position: absolute; width: 700px; height: 700px;
    background: radial-gradient(circle, rgba(245,166,35,0.1), transparent 65%);
    top: 50%; left: 50%; transform: translate(-50%,-50%); pointer-events: none;
  }

  @media(max-width:900px) {
    .lv-grid { grid-template-columns: repeat(2,1fr); }
    .stats-row { grid-template-columns: repeat(2,1fr); gap: 24px; }
    .pr-grid { grid-template-columns: 1fr; max-width: 100%; }
  }
  @media(max-width:600px) {
    .ms-grid { grid-template-columns: 1fr 1fr; }
    .hero-title { font-size: 3rem; }
  }
</style>

<!-- HERO -->
<section class="hero">
  <canvas id="hero-canvas"></canvas>
  <div class="orb orb-a"></div>
  <div class="orb orb-b"></div>
  <div class="orb orb-c"></div>
  <div class="hero-content">
    <div class="hero-eyebrow">🦁 App de inglés · A1 hasta C2</div>
    <div class="hero-logo-wrap">
      <img src="/icon.png" alt="INGLŌ KŌRE" class="hero-icon"/>
      <h1 class="hero-title">INGLŌ <span class="gold">KŌRE</span></h1>
    </div>
    <p class="hero-sub">Aprende inglés de verdad</p>
    <p class="hero-desc">Domina el inglés americano y británico con lecciones interactivas, misiones diarias y certificados de nivel. De A1 a C2, paso a paso.</p>
    <div class="hero-btns">
      <a href="https://play.google.com/store" target="_blank" class="btn-gold">🤖 Google Play — Gratis</a>
      <a href="#funciones" class="btn-ghost">Ver funciones →</a>
    </div>
    <div class="hero-flags">
      <div class="flag-tag">🇺🇸 Inglés Americano</div>
      <div class="flag-tag">🇬🇧 Inglés Británico</div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-wrap">
  <div class="marquee-track">
    <div class="m-chip"><span class="m-dot" style="background:#4A9FE8"></span>A1 Básico 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#4A9FE8"></span>A1+ Básico 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#2A6BB5"></span>A2 Básico 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#1DB87A"></span>B1 Intermedio 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#1DB87A"></span>B1+ Intermedio 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#F5A623"></span>B2 Intermedio 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#F5A623"></span>B2+ Intermedio 4</div>
    <div class="m-chip"><span class="m-dot" style="background:#E8453C"></span>C1 Avanzado 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#E8453C"></span>C1+ Avanzado 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#9B59B6"></span>C2 Avanzado 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#4A9FE8"></span>A1 Básico 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#4A9FE8"></span>A1+ Básico 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#2A6BB5"></span>A2 Básico 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#1DB87A"></span>B1 Intermedio 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#1DB87A"></span>B1+ Intermedio 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#F5A623"></span>B2 Intermedio 3</div>
    <div class="m-chip"><span class="m-dot" style="background:#F5A623"></span>B2+ Intermedio 4</div>
    <div class="m-chip"><span class="m-dot" style="background:#E8453C"></span>C1 Avanzado 1</div>
    <div class="m-chip"><span class="m-dot" style="background:#E8453C"></span>C1+ Avanzado 2</div>
    <div class="m-chip"><span class="m-dot" style="background:#9B59B6"></span>C2 Avanzado 3</div>
  </div>
</div>

<!-- FEATURES -->
<section id="funciones">
  <div class="container">
    <div class="reveal">
      <p class="s-label">¿Por qué INGLŌ KŌRE?</p>
      <h2 class="s-title">Todo lo que necesitas para dominar el inglés</h2>
      <p class="s-desc">Diseñada desde cero para hispanohablantes que quieren aprender inglés de verdad.</p>
    </div>
    <div class="feat-grid">
      <div class="feat-card reveal"><span class="feat-ic">🎯</span><h3 class="feat-t">Fill in the blank interactivo</h3><p class="feat-d">Completa oraciones reales. Aprende gramática en contexto, no de memoria. Feedback inmediato en cada respuesta.</p></div>
      <div class="feat-card reveal"><span class="feat-ic">🔴🟡🟢</span><h3 class="feat-t">Dificultad progresiva</h3><p class="feat-d">Fácil, medio y difícil en cada módulo. El sistema adapta automáticamente los ejercicios a tu nivel.</p></div>
      <div class="feat-card reveal"><span class="feat-ic">📚</span><h3 class="feat-t">Explicaciones paso a paso</h3><p class="feat-d">Al fallar, 3 pasos claros + conclusión explican exactamente por qué. Aprende de cada error (Premium).</p></div>
      <div class="feat-card reveal"><span class="feat-ic">🔥</span><h3 class="feat-t">Racha diaria</h3><p class="feat-d">Mantén tu racha estudiando cada día. El sistema registra tu constancia y premia tu disciplina.</p></div>
      <div class="feat-card reveal"><span class="feat-ic">📄</span><h3 class="feat-t">Certificados de nivel</h3><p class="feat-d">Al completar cada nivel, obtén un certificado PDF descargable. Básico gratis, Premium con sello oficial dorado.</p></div>
      <div class="feat-card reveal"><span class="feat-ic">🇺🇸🇬🇧</span><h3 class="feat-t">Dos acentos reales</h3><p class="feat-d">Americano y británico con sus diferencias de vocabulario, gramática y pronunciación. Progreso separado por acento.</p></div>
    </div>
  </div>
</section>

<!-- LEVELS -->
<section id="niveles" class="lv-bg">
  <div class="container">
    <div class="reveal">
      <p class="s-label">Sistema MCER · Marco Común Europeo</p>
      <h2 class="s-title">De principiante a maestro</h2>
      <p class="s-desc">10 niveles por acento (20 en total). Cada nivel con 6 a 8 módulos temáticos desbloqueados en orden secuencial.</p>
    </div>
    <div class="lv-grid">
      <div class="lv-card reveal" style="border-color:rgba(74,159,232,0.4)"><span class="lv-mcer" style="color:#4A9FE8">A1</span><span class="lv-name">Básico 1</span><span class="lv-free">Gratis</span></div>
      <div class="lv-card reveal" style="border-color:rgba(74,159,232,0.4)"><span class="lv-mcer" style="color:#4A9FE8">A1+</span><span class="lv-name">Básico 2</span><span class="lv-free">Gratis</span></div>
      <div class="lv-card reveal" style="border-color:rgba(42,107,181,0.4)"><span class="lv-mcer" style="color:#2A6BB5">A2</span><span class="lv-name">Básico 3</span><span class="lv-free">Gratis</span></div>
      <div class="lv-card reveal" style="border-color:rgba(29,184,122,0.4)"><span class="lv-mcer" style="color:#1DB87A">B1</span><span class="lv-name">Intermedio 1</span><span class="lv-free">Gratis</span></div>
      <div class="lv-card reveal" style="border-color:rgba(29,184,122,0.25)"><span class="lv-mcer" style="color:#1DB87A">B1+</span><span class="lv-name">Intermedio 2</span><span class="lv-prem">👑 Premium</span></div>
      <div class="lv-card reveal" style="border-color:rgba(245,166,35,0.28)"><span class="lv-mcer" style="color:#F5A623">B2</span><span class="lv-name">Intermedio 3</span><span class="lv-prem">👑 Premium</span></div>
      <div class="lv-card reveal" style="border-color:rgba(245,166,35,0.28)"><span class="lv-mcer" style="color:#F5A623">B2+</span><span class="lv-name">Intermedio 4</span><span class="lv-prem">👑 Premium</span></div>
      <div class="lv-card reveal" style="border-color:rgba(232,69,60,0.28)"><span class="lv-mcer" style="color:#E8453C">C1</span><span class="lv-name">Avanzado 1</span><span class="lv-prem">👑 Premium</span></div>
      <div class="lv-card reveal" style="border-color:rgba(232,69,60,0.28)"><span class="lv-mcer" style="color:#E8453C">C1+</span><span class="lv-name">Avanzado 2</span><span class="lv-prem">👑 Premium</span></div>
      <div class="lv-card reveal" style="border-color:rgba(155,89,182,0.35)"><span class="lv-mcer" style="color:#9B59B6">C2</span><span class="lv-name">Avanzado 3</span><span class="lv-prem">👑 Premium</span></div>
    </div>
  </div>
</section>

<!-- STATS -->
<section class="stats-bg" style="padding:72px 24px">
  <div class="container">
    <div class="stats-row">
      <div class="reveal" style="text-align:center"><span class="st-num">20</span><span class="st-lbl">Niveles disponibles</span></div>
      <div class="reveal" style="text-align:center"><span class="st-num">150+</span><span class="st-lbl">Módulos temáticos</span></div>
      <div class="reveal" style="text-align:center"><span class="st-num">3000+</span><span class="st-lbl">Ejercicios únicos</span></div>
      <div class="reveal" style="text-align:center"><span class="st-num">2</span><span class="st-lbl">Acentos 🇺🇸🇬🇧</span></div>
    </div>
  </div>
</section>

<!-- MISSIONS -->
<section id="misiones">
  <div class="container">
    <div class="reveal">
      <p class="s-label">Motivación diaria</p>
      <h2 class="s-title">Misiones que cambian cada día</h2>
      <p class="s-desc">7 misiones diferentes, una por día de la semana. Complétala y gana XP extra para subir de rango.</p>
    </div>
    <div class="ms-grid">
      <div class="ms-card reveal"><div class="ms-day">Domingo</div><span class="ms-ic">📖</span><div class="ms-t">Completa 1 módulo hoy</div><div class="ms-xp">+20 XP</div></div>
      <div class="ms-card reveal"><div class="ms-day">Lunes</div><span class="ms-ic">🎯</span><div class="ms-t">Responde 20 preguntas</div><div class="ms-xp">+30 XP</div></div>
      <div class="ms-card reveal"><div class="ms-day">Martes</div><span class="ms-ic">📚</span><div class="ms-t">Completa 2 módulos</div><div class="ms-xp">+40 XP</div></div>
      <div class="ms-card reveal"><div class="ms-day">Miércoles</div><span class="ms-ic">⚡</span><div class="ms-t">Responde 25 preguntas</div><div class="ms-xp">+35 XP</div></div>
      <div class="ms-card reveal"><div class="ms-day">Jueves</div><span class="ms-ic">💎</span><div class="ms-t">Módulo perfecto sin errores</div><div class="ms-xp">+50 XP</div></div>
      <div class="ms-card reveal"><div class="ms-day">Viernes</div><span class="ms-ic">🔥</span><div class="ms-t">Responde 30 preguntas</div><div class="ms-xp">+45 XP</div></div>
      <div class="ms-card reveal"><div class="ms-day">Sábado</div><span class="ms-ic">🏆</span><div class="ms-t">Completa 3 módulos</div><div class="ms-xp">+60 XP</div></div>
    </div>
  </div>
</section>

<!-- PRICING -->
<section id="precios" class="lv-bg">
  <div class="container">
    <div class="reveal" style="text-align:center">
      <p class="s-label">Planes</p>
      <h2 class="s-title">Empieza gratis, crece con Premium</h2>
      <p class="s-desc" style="margin:0 auto">Los primeros 4 niveles son 100% gratuitos. Premium desbloquea todo el contenido.</p>
    </div>
    <div class="pr-grid" style="margin:56px auto 0">
      <div class="pr-card reveal">
        <div class="pr-plan">GRATIS</div>
        <div class="pr-price">S/0 <span>/ siempre</span></div>
        <div class="pr-save">Sin tarjeta de crédito</div>
        <ul class="pr-list">
          <li>Niveles A1, A1+, A2, B1</li>
          <li>Misiones diarias</li>
          <li>Racha y estadísticas</li>
          <li>Certificados básicos</li>
        </ul>
      </div>
      <div class="pr-card featured reveal">
        <div class="pr-badge">👑 MÁS POPULAR</div>
        <div class="pr-plan">PREMIUM ANUAL</div>
        <div class="pr-price">S/163.90 <span>/ año</span></div>
        <div class="pr-save">S/13.66/mes · Ahorra 43%</div>
        <ul class="pr-list">
          <li>Todo lo de Gratis</li>
          <li>Niveles B1+ hasta C2</li>
          <li>Sin anuncios</li>
          <li>Explicaciones paso a paso</li>
          <li>Certificados con sello oficial</li>
          <li>Ambos acentos completos</li>
        </ul>
      </div>
    </div>
    <p style="text-align:center;margin-top:20px;color:var(--muted);font-size:0.82rem">También disponible mensual por S/23.90/mes</p>

    <!-- NOTA LEGAL CERTIFICADOS -->
    <div style="display:flex;justify-content:center;margin-top:20px">
      <div class="cert-note reveal">
        <span style="font-size:14px;margin-top:2px">ℹ️</span>
        <p class="cert-note-txt">Los certificados de INGLŌ KŌRE son reconocimientos de progreso dentro de la app y no constituyen certificaciones académicas oficiales reconocidas por instituciones educativas o gubernamentales.</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section id="descargar" class="cta-sec" style="position:relative">
  <div class="cta-glow"></div>
  <div class="container reveal" style="text-align:center;position:relative;z-index:1">
    <img src="/icon.png" style="width:100px;height:100px;border-radius:24px;margin-bottom:28px;animation:goldPulse 3s ease infinite" alt="icon"/>
    <h2 class="s-title">¿Listo para dominar el inglés?</h2>
    <p style="color:var(--muted);font-size:1rem;margin:14px auto 40px;max-width:480px;line-height:1.75">Únete a la comunidad de hispanohablantes aprendiendo inglés de verdad con INGLŌ KŌRE.</p>
    <a href="https://play.google.com/store" target="_blank" class="btn-gold" style="font-size:1.05rem;padding:16px 44px">🤖 Descargar en Google Play</a>
    <p style="color:var(--muted);font-size:0.78rem;margin-top:20px">Disponible para Android · iOS próximamente</p>
