</section>

<script>
  // RAIN CANVAS
  const canvas = document.getElementById('hero-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
  resize();
  window.addEventListener('resize', resize);

  const WORDS = ["it's","are","were","was","have","has","had","been","be","is","do","does","did","will","would","could","should","may","might","shall","the","a","an","in","on","at","to","of","and","but","or","not","yes","no","can","I","you","he","she","we","they","it","A1","B1","C1","B2","C2","A2"];
  const NUM = Math.floor(window.innerWidth / 56);
  const cols = Array.from({length: NUM}, (_, i) => {
    const n = 6 + Math.floor(Math.random() * 5);
    const si = Math.floor(Math.random() * WORDS.length);
    return {
      x: (window.innerWidth / NUM) * i + 8,
      y: Math.random() * -window.innerHeight,
      spd: 0.4 + Math.random() * 0.9,
      words: Array.from({length:n}, (_,j) => WORDS[(si+j) % WORDS.length]),
      op: 0.12 + Math.random() * 0.18,
    };
  });

  function drawRain() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    cols.forEach(c => {
      c.words.forEach((w, i) => {
        const y = c.y + i * 26;
        if (y < -30 || y > canvas.height + 30) return;
        const alpha = i === 0 ? c.op * 2.2 : i === 1 ? c.op * 1.3 : c.op * 0.5;
        ctx.globalAlpha = Math.min(alpha, 0.9);
        ctx.fillStyle = i === 0 ? '#F5A623' : '#4A9FE8';
        ctx.font = `600 11px 'DM Sans', sans-serif`;
        ctx.fillText(w, c.x, y);
      });
      c.y += c.spd;
      if (c.y > canvas.height + 180) c.y = -220;
    });
    ctx.globalAlpha = 1;
    requestAnimationFrame(drawRain);
  }
  drawRain();
</script>

</Layout>
